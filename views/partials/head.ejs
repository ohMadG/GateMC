<%
    const _title = typeof title !== 'undefined' && title ? title : null;
    const _active = typeof active !== 'undefined' ? active : '';
    const _v = typeof viewer !== 'undefined' ? viewer : null;
    const _admin = Boolean(_v && _v.isAdmin);
    const _creator = Boolean(_v && _v.creatorId);
    const _nav = [
        { key: 'overview', href: '/admin', label: 'Overview', icon: 'chart', show: _admin },
        { key: 'creators', href: '/admin#creators', label: 'Creators', icon: 'video', show: _admin },
        { key: 'players', href: '/admin/players', label: 'Players', icon: 'users', show: _admin },
        { key: 'payouts', href: '/admin/payouts', label: 'Payouts', icon: 'wallet', show: _admin },
        { key: 'applications', href: '/admin/applications', label: 'Applications', icon: 'userPlus', show: _admin },
        { key: 'me', href: '/me', label: 'My Dashboard', icon: 'trending', show: _creator },
        { key: 'increase', href: '/me/increase', label: 'Request Increase', icon: 'percent', show: _creator },
        { key: 'apply', href: '/apply', label: 'Apply', icon: 'userPlus', show: !_creator && !_admin },
    ].filter((n) => n.show);
%><!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= _title ? _title + ' · GateMC Media' : 'GateMC Media' %></title>
    <meta name="description" content="The GateMC media partner portal.">
    <meta name="theme-color" content="#0a0912">
    <link rel="icon" href="/img/logo.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lilita+One&family=Rubik:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/portal.css?v=<%= cssVersion %>">
</head>
<body>
    <div class="backdrop" aria-hidden="true"></div>
    <header class="topbar">
        <div class="topbar-inner">
            <a href="/" class="brand" aria-label="GateMC Media home">
                <img src="/img/logo.png" alt="" width="34" height="34">
                <span class="brand-text"><b>GateMC</b><small>Media Portal</small></span>
            </a>
            <nav class="main-nav" id="mainNav" aria-label="Main">
                <% _nav.forEach(function (item) { %>
                    <a href="<%= item.href %>" class="<%= _active === item.key ? 'active' : '' %>"><%- icon(item.icon, 16) %><span><%= item.label %></span></a>
                <% }); %>
            </nav>
            <div class="topbar-right">
                <% if (_v) { %>
                    <div class="user-chip">
                        <img src="<%= _v.avatarUrl %>" alt="" width="30" height="30">
                        <div class="who"><b><%= _v.name %></b><span><%= _admin ? 'Admin' : _creator ? 'Creator' : 'Member' %></span></div>
                        <form method="post" action="/auth/logout"><button type="submit" class="icon-btn" title="Sign out" aria-label="Sign out"><%- icon('logout', 16) %></button></form>
                    </div>
                <% } else { %>
                    <a href="/auth/discord?returnTo=<%= encodeURIComponent(typeof path !== 'undefined' ? path : '/') %>" class="btn discord sm"><%- discordGlyph(16) %> Sign in</a>
                <% } %>
                <% if (_nav.length) { %>
                <button type="button" class="icon-btn menu-toggle" aria-label="Menu" aria-controls="mainNav" onclick="document.getElementById('mainNav').classList.toggle('open')"><%- icon('menu', 18) %></button>
                <% } %>
            </div>
        </div>
    </header>
    <% if (typeof preview !== 'undefined' && preview) { %>
        <div class="preview-banner"><div class="container"><%- icon('eye', 16) %><span>You're previewing <strong><%= c.name %></strong>'s dashboard exactly as they see it.</span><a href="/admin/creators/<%= c.id %>" class="btn sm">Back to admin</a></div></div>
    <% } %>
    <main class="main">
