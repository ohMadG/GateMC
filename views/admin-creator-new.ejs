<%- include('partials/head', { title, active }) %>
<div class="container narrow">
    <div class="crumbs"><a href="/admin">Overview</a><%- icon('chevronRight', 14) %><span>Add creator</span></div>
    <div class="page-head"><h1>Add a creator</h1><p class="lead">Set their address, cut and how long their players count for. You can change all of it later.</p></div>
    <form method="post" action="/admin/creators" class="card">
        <% if (error) { %><div class="alert bad" style="margin-bottom: 18px;"><%- icon('alert') %><div><%= error %></div></div><% } %>
        <div class="form-grid" style="margin-bottom: 16px;">
            <div class="field"><label for="host">Server address</label><input id="host" name="host" maxlength="120" placeholder="name" value="<%= values.host || '' %>"><span class="hint">Just the name becomes name.<%= baseDomain %>. Add a DNS-only A record for it in Cloudflare.</span></div>
            <div class="field"><label for="cut_percent">Cut (%)</label><input type="number" id="cut_percent" name="cut_percent" required min="0" max="100" step="0.5" value="<%= values.cut_percent || 10 %>"></div>
        </div>
        <%- include('partials/creator-fields', { values }) %>
        <div class="form-actions"><button class="btn primary lg" type="submit">Add creator</button><a href="/admin" class="btn ghost lg">Cancel</a></div>
    </form>
</div>
<%- include('partials/foot') %>
