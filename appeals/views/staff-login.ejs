<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>GateMC Appeals - Staff</title>
    <link rel="icon" href="/img/logo.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <div class="login-page">
        <div class="brand-panel">
            <div class="brand-mark">
                <img src="/img/logo.png" alt="GateMC">
                <span>GATEMC APPEALS</span>
            </div>
            <div class="brand-copy">
                <h1>Review appeals for GateMC.</h1>
                <p>Sign in with the Discord account you use in the GateMC server. Access is restricted to staff
                    holding the staff role.</p>
            </div>
            <div class="brand-foot">Access is restricted to approved staff accounts.</div>
        </div>
        <div class="form-panel">
            <div class="login-box">
                <h2>Staff sign in</h2>
                <p class="subtitle">Use your Discord account.</p>
                <% if (error) { %><div class="error"><%= error %></div><% } %>
                <a href="<%= discordAuthUrl %>"><button type="button" style="width:100%;">Login with Discord</button></a>
            </div>
        </div>
    </div>
</body>
</html>
