PORT=8095

# Random long string, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
SESSION_SECRET=

# --- Player sign-in: Google Identity Services ---
# You can reuse the panel's existing Google OAuth Client ID - just add
# https://appeals.gatemc.org as an extra Authorized JavaScript origin on it
# in https://console.cloud.google.com/apis/credentials. No client secret needed.
GOOGLE_CLIENT_ID=

# --- Staff sign-in: Discord OAuth2 + a bot to check the staff role ---
# Create one Discord application (e.g. "Warden") at https://discord.com/developers/applications
# OAuth2 tab: Client ID / Client Secret below. Add this exact redirect URL there:
#   https://appeals.gatemc.org/staff/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Bot tab of the same application: create a bot, copy its token, invite it to the
# GateMC Discord server (no privileged intents needed - it only does a single
# GET /guilds/{id}/members/{user} REST lookup per login, not a live gateway connection).
DISCORD_BOT_TOKEN=

# The GateMC Discord server's ID, and the role ID(s) that count as "staff" - comma separated,
# since ranks here don't stack (e.g. "Sr Mod or higher" means Sr Mod, Admin, Co-Owner and Owner
# are each a separate role a member holds, not an inherited chain).
# (enable Developer Mode in Discord, then right-click the server/role -> Copy ID).
DISCORD_GUILD_ID=
DISCORD_STAFF_ROLE_IDS=

# The role ID(s) for "admin or higher" - comma separated, same reasoning as above. Required to
# approve or reduce an IPBAN appeal. Blank means no one gets the admin tier (fails closed, not
# open) until this is set.
DISCORD_ADMIN_ROLE_IDS=

# The role ID(s) for a senior-staff tier that can also approve or reduce an IPBAN appeal, even
# without the admin role above - comma separated, same reasoning as above. Also counts as staff.
# Blank means no one gets this tier.
DISCORD_SENIOR_ROLE_IDS=

# Same values as GateMC's own storage: section in its config.yml (must be postgres).
PGHOST=172.18.0.1
PGPORT=5432
PGDATABASE=gatemc_dev
PGUSER=gatemc_dev
PGPASSWORD=

# Optional - a Discord webhook URL (channel Settings -> Integrations -> Webhooks). Blank = no posts.
# Posts on: new appeal submitted (pings the admin role(s) above for IPBAN appeals), approved,
# denied, reduced, expired, reopened, status changed, and ClamAV going down/recovering.
DISCORD_WEBHOOK_URL=

# ClamAV sidecar container (clamd) used to scan uploaded screenshots. Defaults match the
# gatemc-clamav container on the pterodactyl_nw network.
CLAMAV_HOST=gatemc-clamav
CLAMAV_PORT=3310

# Where uploaded screenshots are stored inside the container - mount this as a volume
# (e.g. -v /home/gatemc/appeals-uploads:/app/uploads) so they survive redeploys.
UPLOAD_DIR=/app/uploads

# Optional - emails the player (at the Google address they signed in with) when their appeal
# is approved, denied, or reduced. Blank RESEND_API_KEY = no emails sent.
# Get a key at https://resend.com/api-keys. RESEND_FROM needs a domain verified with Resend
# (https://resend.com/domains) to send as e.g. "GateMC Appeals <appeals@gatemc.org>" - until
# then it falls back to Resend's own onboarding@resend.dev sender.
RESEND_API_KEY=
RESEND_FROM=GateMC Appeals <appeals@gatemc.org>

# Optional - hCaptcha on the public appeal form, to stop scripted submissions. Get a site key
# and secret at https://dashboard.hcaptcha.com/sites/new. Blank HCAPTCHA_SECRET = no captcha
# shown and nothing is checked, so the form keeps working until this is set up.
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET=
